# --- PostgreSQL Database ---
POSTGRES_USER=aicte_admin
POSTGRES_PASSWORD=aicte_secure_password_2025
POSTGRES_DB=pramaan_x
POSTGRES_PORT=5432
# Local dev SQLite fallback: sqlite:///./pramaan_x.db
DATABASE_URL=postgresql://aicte_admin:aicte_secure_password_2025@localhost:5432/pramaan_x

# --- FastAPI Backend Service ---
BACKEND_PORT=8000
SECRET_KEY=pramaan-x-hackathon-super-secret-key-2025-aicte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MOCK_ISSUER_URL=http://localhost:8001
CORS_ORIGINS=*

# --- Standalone Mock Issuer Service ---
MOCK_ISSUER_PORT=8001

# --- React Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api/v1

